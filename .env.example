# Verity — environment configuration
# Copy to .env for local overrides. Never commit a real .env file.

# --- Supabase (sign-in + durable backups) -----------------------------------
# Leave these empty to run in single-user local mode (no sign-in screen).
# Find them in Supabase: Project Settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only secret. Used to back up each user's workspace to a private Storage bucket.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket name for workspace backups (created automatically on startup)
VERITY_BACKUP_BUCKET=workspaces

# --- App ----------------------------------------------------------------------
VERITY_ENV=development
VERITY_ENABLE_DOCS=true
# Built-in demo scenarios + synthetic benchmark endpoints. Keep false for real users.
VERITY_ENABLE_DEMO=false
VERITY_LOG_LEVEL=INFO

# Where per-user workspaces live on disk
VERITY_WORKSPACE_DIR=data/workspaces
# Database used in local (no sign-in) mode
VERITY_DATABASE_URL=sqlite:///data/verity.db

# --- Upload limits --------------------------------------------------------------
VERITY_MAX_UPLOAD_MB=15.0
VERITY_MAX_TEXT_LENGTH=250000
VERITY_MAX_FILES_PER_CASE=20

# CORS (only needed if the frontend is served from a different origin)
VERITY_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Optional AI-assisted reading of scanned PDFs / screenshots ------------------
# MOCK (default, no key needed), GEMINI, OPENAI_COMPATIBLE
VERITY_AI_PROVIDER=MOCK
VERITY_AI_MODEL=gemini-3.6-flash
# Name of the env var holding the key (not the key itself)
VERITY_AI_API_KEY_ENV_VAR=GEMINI_API_KEY
VERITY_AI_TIMEOUT=30
# GEMINI_API_KEY=your-key
